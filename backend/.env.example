# Postgres in production / docker, SQLite by default so nobody is blocked
DATABASE_URL=postgresql+psycopg2://stocksense:stocksense@localhost:5432/stocksense
SECRET_KEY=change-me-before-demo
ACCESS_TOKEN_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=10
# In dev the OTP is returned by the API and printed to the console instead of emailed
DEV_SHOW_OTP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
